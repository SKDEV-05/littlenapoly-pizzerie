# ==============================================================================
# LITTLE NAPOLI FRONTEND - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Trage diese Variablen in Vercel / Netlify / Cloudflare Pages Dashboard ein:
# Settings -> Environment Variables
# ==============================================================================

# Deine InfinityFree Backend URL (mit oder ohne /api/v1 - beides funktioniert automatisch)
NEXT_PUBLIC_API_URL=https://DEINE-INFINITYFREE-SUBDOMAIN.epizy.com/api/v1

# Deine Live Frontend URL (z.B. auf Vercel oder Netlify)
NEXT_PUBLIC_SITE_URL=https://littlenapoli.vercel.app
