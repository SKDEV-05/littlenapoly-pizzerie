# ==============================================================================
# LITTLE NAPOLI - INFINITYFREE BACKEND CONFIGURATION TEMPLATE
# ==============================================================================
# Anleitung:
# 1. Benenne diese Datei auf InfinityFree in ".env" um (in htdocs/.env).
# 2. Trage die MySQL-Zugangsdaten aus deinem InfinityFree Control Panel ein.
# ==============================================================================

APP_NAME="Little Napoli API"
APP_ENV=production
APP_KEY=base64:3qgXk7wM4fF2T+Yh9B6jK1zR8lQ5sU2vP0xO4eA7dG8=
APP_DEBUG=false
APP_TIMEZONE=Europe/Vienna

# Deine InfinityFree Domain / Subdomain (z.B. https://littlenapoli.epizy.com)
APP_URL=https://DEINE-SUBDOMAIN.epizy.com

APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

# ==============================================================================
# MYSQL DATENBANK (aus dem InfinityFree Control Panel -> "MySQL Databases")
# ==============================================================================
DB_CONNECTION=mysql

# MySQL Hostname (z.B. sql100.epizy.com oder sql205.infinityfree.com)
DB_HOST=sqlXXX.epizy.com

DB_PORT=3306

# Datenbankname (z.B. epiz_12345678_littlenapoli)
DB_DATABASE=epiz_XXXXXXXX_littlenapoli

# MySQL Benutzername (z.B. epiz_12345678)
DB_USERNAME=epiz_XXXXXXXX

# Dein vPanel / InfinityFree Account Passwort
DB_PASSWORD=DEIN_ACCOUNT_PASSWORT

# ==============================================================================
# TREIBER & CORS
# ==============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Erlaubt Zugriff von deinem Vercel / Netlify Frontend
CORS_ALLOWED_ORIGINS="*"

# Optional: Stripe API Schlüssel
STRIPE_KEY=pk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
